# Mist Switch Port Operator Toolkit - environment template
# Copy this file to .env and fill in your values.  .env is git-ignored.

# REQUIRED: org-scoped Mist API token (never printed or logged)
MIST_API_TOKEN=

# OPTIONAL: regional cloud base URL (default: https://api.mist.com)
# Examples: https://api.eu.mist.com  https://api.ac2.mist.com  https://api.gc1.mist.com
MIST_BASE_URL=

# OPTIONAL: org id to operate on; skips the org prompt when it matches the
# token's privileges (find it under Organisation > Settings)
MIST_ORG_ID=

# OPTIONAL: pre-selects this site, equivalent to answering the site prompt
MIST_SITE_ID=